DEFINE
    MEASURE 'Ads'[Total Spend] =
        SUM ( Ads[spend] )

    MEASURE 'Ads'[Total Impressions] =
        SUM ( Ads[impressions] )

    MEASURE 'Ads'[Total Clicks] =
        SUM ( Ads[clicks] )

    MEASURE 'Ads'[Total Conversions] =
        SUM ( Ads[conversions] )

    MEASURE 'Ads'[Tracked Revenue] =
        SUM ( Ads[conversion_value] )

    MEASURE 'Ads'[Blended CTR] =
        DIVIDE ( [Total Clicks], [Total Impressions] )

    MEASURE 'Ads'[Blended CPC] =
        DIVIDE ( [Total Spend], [Total Clicks] )

    MEASURE 'Ads'[Blended CPM] =
        DIVIDE ( [Total Spend] * 1000, [Total Impressions] )

    MEASURE 'Ads'[Blended CVR] =
        DIVIDE ( [Total Conversions], [Total Clicks] )

    MEASURE 'Ads'[Blended CPA] =
        DIVIDE ( [Total Spend], [Total Conversions] )

    MEASURE 'Ads'[Blended ROAS] =
        DIVIDE ( [Tracked Revenue], [Total Spend] )

    MEASURE 'Ads'[Total Video Views] =
        SUM ( Ads[video_views] )

    MEASURE 'Ads'[Video View Rate] =
        DIVIDE ( [Total Video Views], [Total Impressions] )

    MEASURE 'Ads'[Video Completion Rate] =
        DIVIDE ( SUM ( Ads[video_watch_100] ), [Total Video Views] )

    MEASURE 'Ads'[Total Engagements] =
        SUM ( Ads[engagements] )

    MEASURE 'Ads'[Engagement Rate] =
        DIVIDE ( [Total Engagements], [Total Impressions] )

    MEASURE 'Ads'[Spend Share] =
        DIVIDE (
            [Total Spend],
            CALCULATE ( [Total Spend], ALL ( Ads[platform] ) )
        )

    MEASURE 'Ads'[Average Frequency] =
        AVERAGE ( Ads[frequency] )

    MEASURE 'Ads'[Average Quality Score] =
        AVERAGE ( Ads[quality_score] )

    MEASURE 'Ads'[Average Search Impression Share] =
        AVERAGE ( Ads[search_impression_share] )

    MEASURE 'Ads'[Campaign Rank by CPA] =
        RANKX (
            ALLSELECTED ( Ads[campaign_display_name] ),
            [Blended CPA],
            ,
            ASC,
            DENSE
        )

    MEASURE 'Ads'[Campaign Rank by Conversions] =
        RANKX (
            ALLSELECTED ( Ads[campaign_display_name] ),
            [Total Conversions],
            ,
            DESC,
            DENSE
        )

    MEASURE 'Ads'[CPA Efficiency Band] =
        SWITCH (
            TRUE (),
            ISBLANK ( [Blended CPA] ), "No conversions",
            [Blended CPA] <= 8, "Scale / protect",
            [Blended CPA] <= 15, "Monitor",
            "Optimize / reduce"
        )

EVALUATE
ROW (
    "Total Spend", [Total Spend],
    "Total Impressions", [Total Impressions],
    "Total Clicks", [Total Clicks],
    "Total Conversions", [Total Conversions],
    "Blended CPA", [Blended CPA]
)
